# Required for Chord registration (auth_type bearer)
MCP_BEARER_TOKEN=change-me
# Public hostname(s) the server is reached on, comma-separated, exact match (e.g. abcd.ngrok-free.app)
MCP_ALLOWED_HOSTS=

# Storage: leave both unset to use data/store.json locally
SHEET_ID=
GOOGLE_SA_JSON=
# Or paste the whole service-account JSON on one line (for hosts with no file to mount)
GOOGLE_SA_JSON_CONTENT=

# Vending: mock (default) or vtpass
VEND_PROVIDER=mock
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_SERVICE_ID=ikeja-electric
VTPASS_VARIATION=prepaid

# Shop tuning
GEN_LITRES_PER_HOUR=1.8
TARIFF_NGN_PER_KWH=225
WEEKLY_DIESEL_BUDGET_NGN=150000
MAX_UNATTENDED_NGN=20000
DIESEL_ALERT_DAYS=1
PORT=8000
